<?xml version="1.0" encoding="UTF-8"?>
<!--
  A minimal SOAP 1.1 envelope schema, existing only so a whole response
  document can be handed to a schema processor in one piece:

      xmllint (noout, schema) testdata/schema/soap11-envelope.xsd FILE

  It imports the OPC XML-DA schema and declares Body's payload as
  processContents="strict", so the payload is validated against
  opcxmlda.xsd rather than skipped — which is the entire point. A lax or
  skip setting would make the whole exercise pass on anything.

  This is not the official SOAP 1.1 schema (which is not redistributed
  here); it models exactly the envelope shape this server emits, plus
  Fault, and nothing more.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:env="http://schemas.xmlsoap.org/soap/envelope/"
           targetNamespace="http://schemas.xmlsoap.org/soap/envelope/"
           elementFormDefault="qualified">

  <xs:import namespace="http://opcfoundation.org/webservices/XMLDA/1.0/"
             schemaLocation="opcxmlda.xsd"/>

  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="env:Header" minOccurs="0"/>
        <xs:element ref="env:Body"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Header">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Body">
    <xs:complexType>
      <xs:choice minOccurs="0">
        <xs:element ref="env:Fault"/>
        <!-- The OPC XML-DA payload: strict, so it must match a global
             element declaration in the imported schema. -->
        <xs:any namespace="##other" processContents="strict"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Fault's children are unqualified in SOAP 1.1, hence form="unqualified". -->
  <xs:element name="Fault">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="faultcode" type="xs:QName" form="unqualified"/>
        <xs:element name="faultstring" type="xs:string" form="unqualified"/>
        <xs:element name="faultactor" type="xs:anyURI" form="unqualified" minOccurs="0"/>
        <xs:element name="detail" form="unqualified" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:anyAttribute namespace="##any" processContents="lax"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
